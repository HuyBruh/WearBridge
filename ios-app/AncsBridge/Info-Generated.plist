<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>WearBridge</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>1.1</string>
	<key>CFBundleVersion</key>
	<string>2</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>NSCalendarsFullAccessUsageDescription</key>
	<string>Share the next three calendar events with your paired watch when you enable calendar sharing.</string>
	<key>NSHealthUpdateUsageDescription</key>
	<string>Save timed workouts that you choose to sync from your watch.</string>
	<key>NSCameraUsageDescription</key>
	<string>Use your paired watch as a shutter while the camera is open.</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>Save photos captured with the remote shutter.</string>
	<key>NSBluetoothAlwaysUsageDescription</key>
	<string>WearBridge needs Bluetooth to connect to your Pixel Watch and forward notifications.</string>
	<key>NSBluetoothPeripheralUsageDescription</key>
	<string>WearBridge needs Bluetooth to be discoverable by your Pixel Watch.</string>
	<key>UIBackgroundModes</key>
	<array>
		<string>bluetooth-peripheral</string>
	</array>
	<key>UILaunchScreen</key>
	<dict/>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
</dict>
</plist>
